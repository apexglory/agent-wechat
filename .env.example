# Per-host config for docker-compose.yml. Copy to `.env` (gitignored) on each
# host and fill in. Compose auto-loads `.env` from this directory.
#
# ─────────────────────────────────────────────────────────────────────────────
# Image — the tag you shipped with scripts/ship-image.sh and `docker load`.
# Pin a VERSION; do not use a moving tag in production.
AGENT_WECHAT_IMAGE=agent-wechat2:0.12.0

# Container name. agent-wechat2 keeps the CLI (`wx`) consistent with the new
# naming. (The old containers were named `agent-wechat`.)
AGENT_WECHAT_CONTAINER=agent-wechat2

# Host port to publish 6174 on.
AGENT_WECHAT_PORT=6174

# Host path to the auth token mounted read-only into the container. The new
# `wx` CLI reads ~/.config/agent-wechat2/token; keep these in sync.
AGENT_WECHAT_TOKEN=/root/.config/agent-wechat2/token

TZ=Asia/Shanghai

# ─────────────────────────────────────────────────────────────────────────────
# Volumes — THE IMPORTANT PART.
#
# These MUST name volumes that ALREADY hold this host's WeChat login + data.
# Migrating an existing host onto the image flow is then ZERO-COPY: the new
# image-based container mounts the same volumes the old `agent-wechat` container
# used, so the logged-in session carries over and nothing is recreated empty.
#
# Find the real names on the host:
#   docker inspect <old-container> \
#     --format '{{range .Mounts}}{{.Name}} -> {{.Destination}}{{println}}{{end}}'
#
# Typical legacy values (verify per host — they have historically drifted):
AGENT_WECHAT_DATA_VOLUME=agent-wechat-data
AGENT_WECHAT_HOME_VOLUME=agent-wechat-wechat-home
#
# A brand-new host (no prior login) instead uses fresh volumes — create them
# first (`docker volume create agent-wechat2-data`) and set them here:
#   AGENT_WECHAT_DATA_VOLUME=agent-wechat2-data
#   AGENT_WECHAT_HOME_VOLUME=agent-wechat2-wechat-home
